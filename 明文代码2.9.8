        if (ipv6启用) 抓取任务.push(解析Wetest页面(v6网址));
        else 抓取任务.push(Promise.resolve([]));
        const [ipv4列表, ipv6列表] = await Promise.all(抓取任务);
        结果 = [...ipv4列表, ...ipv6列表];
