// 检查IP可用性
async function 检查IP可用性(域名, 端口 = 443, 超时 = 2000) {
    try {
        const 控制器 = new AbortController();
        const 定时器 = setTimeout(() => 控制器.abort(), 超时);
        const 响应 = await fetch(`https://${域名}`, { method: 'HEAD', signal: 控制器.signal, headers: { 'User-Agent': 'Mozilla/5.0' } });
        clearTimeout(定时器);
        return 响应.status < 500;
    } catch (error) { return true; }
}

// 获取最佳备用IP
async function 获取最佳备用IP(worker地区 = '', 使用地区匹配 = 启用地区匹配) {
    if (备用IP列表.length === 0) return null;
    const 可用IP列表 = 备用IP列表.map(ip => ({ ...ip, 可用: true }));
    if (使用地区匹配 && worker地区) {
        const 排序后 = 智能地区选择(worker地区, 可用IP列表, 使用地区匹配);
        if (排序后.length > 0) return 排序后[0];
    }
    return 可用IP列表[0];
}

// 获取邻近地区
function 获取邻近地区(地区) {
    const 邻近映射 = {
        'US': ['SG', 'JP', 'KR'], 'SG': ['JP', 'KR', 'US'], 'JP': ['SG', 'KR', 'US'],
        'KR': ['JP', 'SG', 'US'], 'DE': ['NL', 'GB', 'SE', 'FI'], 'SE': ['DE', 'NL', 'FI', 'GB'],
        'NL': ['DE', 'GB', 'SE', 'FI'], 'FI': ['SE', 'DE', 'NL', 'GB'], 'GB': ['DE', 'NL', 'SE', 'FI']
    };
    return 邻近映射[地区] || [];
}

// 按优先级获取所有地区
function 按优先级获取地区(地区) {
    const 邻近 = 获取邻近地区(地区);
    const 所有地区 = ['US', 'SG', 'JP', 'KR', 'DE', 'SE', 'NL', 'FI', 'GB'];
    return [地区, ...邻近, ...所有地区.filter(r => r !==地区 && !邻近.includes(r))];
}

// 智能地区选择
function 智能地区选择(worker地区, 可用IP列表, 使用地区匹配 = 启用地区匹配) {
    if (!使用地区匹配 || !worker地区) return 可用IP列表;
    const 优先级地区 = 按优先级获取地区(worker地区);
    const 排序后 = [];
    for (const 地区 of 优先级地区) {
        const 地区IP = 可用IP列表.filter(ip => ip.regionCode === 地区);
        排序后.push(...地区IP);
    }
    return 排序后;
}

// 解析地址和端口
function 解析地址和端口(输入) {
    if (输入.includes('[') && 输入.includes(']')) {
        const 匹配 = 输入.match(/^\[([^\]]+)\](?::(\d+))?$/);
        if (匹配) return { 地址: 匹配[1], 端口: 匹配[2] ? parseInt(匹配[2], 10) : null };
    }
    const 最后一个冒号索引 = 输入.lastIndexOf(':');
    if (最后一个冒号索引 > 0) {
        const 地址 = 输入.substring(0, 最后一个冒号索引);
        const 端口字符串 = 输入.substring(最后一个冒号索引 + 1);
        const 端口 = parseInt(端口字符串, 10);
        if (!地址.includes(':') && !isNaN(端口) && 端口 > 0 && 端口 <= 65535) return { 地址, 端口 };
    }
    return { 地址: 输入, 端口: null };
}
















export default {
    async fetch(request, env, ctx) {
        try {
            const 是否WebSocket = request.headers.get('Upgrade') === atob('d2Vic29ja2V0');
            const 是否POST = request.method === 'POST';
            const 请求URL = new URL(request.url);
            const 路径分段 = 请求URL.pathname.split('/').filter(p => p);

            if (!是否WebSocket && !是否POST && 请求URL.pathname !== '/') {
                const 临时UUID = (env.u || env.U || '').toLowerCase();
                const 临时路径 = (env.d || env.D || '').toLowerCase();
                const 首段 = 路径分段[0] || '';
                const 清洗路径 = 临时路径.startsWith('/') ? 临时路径.substring(1) : 临时路径;
                if (首段 !== 临时UUID && (清洗路径 ? 首段 !== 清洗路径 : false)) {
                    return new Response('Not Found', { status: 404 });
                }
            }

            await 初始化KV存储(env);

            用户UUID = (env.u || env.U || 用户UUID).toLowerCase();
            const 订阅路径 = (env.d || env.D || 用户UUID).toLowerCase();

            const 自定义IP值 = 获取配置值('p', env.p || env.P);
            let 使用自定义IP = false;
            const 手动地区 = 获取配置值('wk', env.wk || env.WK);
            if (手动地区 && 手动地区.trim()) {
                手动指定地区 = 手动地区.trim().toUpperCase();
                当前Worker地区 = 手动指定地区;
            } else if (自定义IP值 && 自定义IP值.trim()) {
                使用自定义IP = true;
                当前Worker地区 = 'CUSTOM';
            } else {
                当前Worker地区 = await 检测Worker地区(request);
            }

            const 地区匹配控制 = env.rm || env.RM;
            if (地区匹配控制 && 地区匹配控制.toLowerCase() === 'no') 启用地区匹配 = false;

            const 环境备用 = 获取配置值('p', env.p || env.P);
            if (环境备用) 备用地址 = 环境备用.trim();

            SOCKS5配置 = 获取配置值('s', env.s || env.S) || SOCKS5配置;
            if (SOCKS5配置) {
                try { 解析后的SOCKS5配置 = 解析SOCKS5配置(SOCKS5配置); 是否启用SOCKS5 = true; }
                catch (err) { 是否启用SOCKS5 = false; }
            }

            const 自定义优选值 = 获取配置值('yx', env.yx || env.YX);
            if (自定义优选值) {
                try {
                    const 优选列表 = 自定义优选值.split(',').map(item => item.trim()).filter(item => item);
                    自定义优选IP列表 = [];
                    自定义优选域名列表 = [];
                    优选列表.forEach(item => {
                        let 节点名 = '';
                        let 地址部分 = item;
                        if (item.includes('#')) { const 分割 = item.split('#'); 地址部分 = 分割[0].trim(); 节点名 = 分割[1].trim(); }
                        const { 地址, 端口 } = 解析地址和端口(地址部分);
                        if (!节点名) 节点名 = '自定义优选-' + 地址 + (端口 ? ':' + 端口 : '');
                        if (校验IP地址(地址)) 自定义优选IP列表.push({ ip: 地址, port: 端口, isp: 节点名 });
                        else 自定义优选域名列表.push({ domain: 地址, port: 端口, name: 节点名 });
                    });
                } catch (err) { 自定义优选IP列表 = []; 自定义优选域名列表 = []; }
            }

            const 降级控制值 = 获取配置值('qj', env.qj || env.QJ);
            if (降级控制值 && 降级控制值.toLowerCase() === 'no') 启用降级模式 = true;

            const 仅TLS控制 = 获取配置值('dkby', env.dkby || env.DKBY);
            if (仅TLS控制 && 仅TLS控制.toLowerCase() === 'yes') 禁用非TLS = true;
            else 禁用非TLS = true; // 默认仅TLS

            const 优选控制 = env.yxby || env.YXBY;
            if (优选控制 && 优选控制.toLowerCase() === 'yes') 禁用优选 = true;

            const vless控制 = 获取配置值('ev', env.ev);
            if (vless控制 !== undefined && vless控制 !== '') 启用VLESS = vless控制 === 'yes' || vless控制 === true || vless控制 === 'true';

            const trojan控制 = 获取配置值('et', env.et);
            if (trojan控制 !== undefined && trojan控制 !== '') 启用Trojan = trojan控制 === 'yes' || trojan控制 === true || trojan控制 === 'true';

            Trojan密码 = 获取配置值('tp', env.tp) || '';

            const xhttp控制 = 获取配置值('ex', env.ex);
            if (xhttp控制 !== undefined && xhttp控制 !== '') 启用XHTTP = xhttp控制 === 'yes' || xhttp控制 === true || xhttp控制 === 'true';

            订阅转换地址 = 获取配置值('scu', env.scu) || 'https://url.v1.mk/sub';

            const 优选域名控制 = 获取配置值('epd', env.epd || 'yes');
            if (优选域名控制 !== undefined && 优选域名控制 !== '') 启用优选域名 = 优选域名控制 !== 'no' && 优选域名控制 !== false && 优选域名控制 !== 'false';

            const 优选IP控制 = 获取配置值('epi', env.epi);
            if (优选IP控制 !== undefined && 优选IP控制 !== '') 启用优选IP = 优选IP控制 !== 'no' && 优选IP控制 !== false && 优选IP控制 !== 'false';

            const GitHub优选控制 = 获取配置值('egi', env.egi);
            if (GitHub优选控制 !== undefined && GitHub优选控制 !== '') 启用GitHub优选 = GitHub优选控制 !== 'no' && GitHub优选控制 !== false && GitHub优选控制 !== 'false';

            const 原生地址控制 = 获取配置值('ena', env.ena);
            if (原生地址控制 !== undefined && 原生地址控制 !== '') 启用原生地址 = 原生地址控制 !== 'no' && 原生地址控制 !== false && 原生地址控制 !== 'false';

            const ech控制 = 获取配置值('ech', env.ech);
            if (ech控制 !== undefined && ech控制 !== '') 启用ECH = ech控制 === 'yes' || ech控制 === true || ech控制 === 'true';

            const 自定义DNS值 = 获取配置值('customDNS', '');
            if (自定义DNS值 && 自定义DNS值.trim()) 自定义DNS = 自定义DNS值.trim();
            const 自定义ECH域名值 = 获取配置值('customECHDomain', '');
            if (自定义ECH域名值 && 自定义ECH域名值.trim()) 自定义ECH域名 = 自定义ECH域名值.trim();

            自定义ALPN = 规范化ALPN(获取配置值('alpn', env.alpn || env.ALPN || 'h3'));

            // ECH 自动开启仅TLS
            if (启用ECH) {
                禁用非TLS = true;
                const 当前仅TLS = 获取配置值('dkby', '');
                if (当前仅TLS !== 'yes') await 设置配置值('dkby', 'yes');
            }

            if (!启用VLESS && !启用Trojan && !启用XHTTP) {
                启用VLESS = true;
                启用Trojan = true;
            }

            优选IP来源URL = 获取配置值('yxURL', env.yxURL || env.YXURL) || '';
            自定义路径 = 获取配置值('d', env.d || env.D) || '';

            const url = new URL(request.url);

            // API 路由处理
            if (url.pathname.includes('/api/config')) {
                const 路径分段数组 = url.pathname.split('/').filter(p => p);
                const api索引 = 路径分段数组.indexOf('api');
                if (api索引 > 0) {
                    const 前部路径 = 路径分段数组.slice(0, api索引);
                    const 路径标识 = 前部路径.join('/');
                    let 验证通过 = false;
                    if (自定义路径 && 自定义路径.trim()) {
                        const 清洗 = 自定义路径.trim().startsWith('/') ? 自定义路径.trim().substring(1) : 自定义路径.trim();
                        验证通过 = (路径标识 === 清洗);
                    } else {
                        验证通过 = (校验UUID格式(路径标识) && 路径标识 === 用户UUID);
                    }
                    if (验证通过) return await 处理配置API(request);
                    else return new Response(JSON.stringify({ error: '路径验证失败' }), { status: 403, headers: { 'Content-Type': 'application/json' } });
                }
                return new Response(JSON.stringify({ error: '无效的API路径' }), { status: 404, headers: { 'Content-Type': 'application/json' } });
            }

            if (url.pathname.includes('/api/preferred-ips')) {
                const 路径分段数组 = url.pathname.split('/').filter(p => p);
                const api索引 = 路径分段数组.indexOf('api');
                if (api索引 > 0) {
                    const 前部路径 = 路径分段数组.slice(0, api索引);
                    const 路径标识 = 前部路径.join('/');
                    let 验证通过 = false;
                    if (自定义路径 && 自定义路径.trim()) {
                        const 清洗 = 自定义路径.trim().startsWith('/') ? 自定义路径.trim().substring(1) : 自定义路径.trim();
                        验证通过 = (路径标识 === 清洗);
                    } else {
                        验证通过 = (校验UUID格式(路径标识) && 路径标识 === 用户UUID);
                    }
                    if (验证通过) return await 处理优选IPAPI(request);
                    else return new Response(JSON.stringify({ error: '路径验证失败' }), { status: 403, headers: { 'Content-Type': 'application/json' } });
                }
                return new Response(JSON.stringify({ error: '无效的API路径' }), { status: 404, headers: { 'Content-Type': 'application/json' } });
            }

            if (request.method === 'POST' && 启用XHTTP) {
                const r = await 处理XHTTP请求(request);
                if (r) {
                    ctx.waitUntil(r.closed);
                    return new Response(r.readable, {
                        headers: {
                            'X-Accel-Buffering': 'no',
                            'Cache-Control': 'no-store',
                            Connection: 'keep-alive',
                            'User-Agent': 'Go-http-client/2.0',
                            'Content-Type': 'application/grpc',
                        },
                    });
                }
                return new Response('Internal Server Error', { status: 500 });
            }

            if (request.headers.get('Upgrade') === atob('d2Vic29ja2V0')) {
                return await 处理WebSocket请求(request);
            }

            // GET 和 HEAD 都进入订阅相关路由（支持 ECH 状态检测）
            if (request.method === 'GET' || request.method === 'HEAD') {
                // 处理 /region 接口
                if (url.pathname.endsWith('/region')) {
                    const 路径分段数组 = url.pathname.split('/').filter(p => p);
                    if (路径分段数组.length === 2 && 路径分段数组[1] === 'region') {
                        const 路径标识 = 路径分段数组[0];
                        let 验证通过 = false;
                        if (自定义路径 && 自定义路径.trim()) {
                            const 清洗 = 自定义路径.trim().startsWith('/') ? 自定义路径.trim().substring(1) : 自定义路径.trim();
                            验证通过 = (路径标识 === 清洗);
                        } else {
                            验证通过 = (校验UUID格式(路径标识) && 路径标识 === 用户UUID);
                        }
                        if (验证通过) {
                            const 自定义IP = 获取配置值('p', env.p || env.P);
                            const 手动地区值 = 获取配置值('wk', env.wk || env.WK);
                            if (手动地区值 && 手动地区值.trim()) {
                                return new Response(JSON.stringify({
                                    region: 手动地区值.trim().toUpperCase(),
                                    detectionMethod: '手动指定地区',
                                    manualRegion: 手动地区值.trim().toUpperCase(),
                                    timestamp: new Date().toISOString()
                                }), { headers: { 'Content-Type': 'application/json' } });
                            } else if (自定义IP && 自定义IP.trim()) {
                                return new Response(JSON.stringify({
                                    region: 'CUSTOM',
                                    detectionMethod: '自定义ProxyIP模式', ci: 自定义IP,
                                    timestamp: new Date().toISOString()
                                }), { headers: { 'Content-Type': 'application/json' } });
                            } else {
                                const 检测地区 = await 检测Worker地区(request);
                                return new Response(JSON.stringify({
                                    region: 检测地区,
                                    detectionMethod: 'API检测',
                                    timestamp: new Date().toISOString()
                                }), { headers: { 'Content-Type': 'application/json' } });
                            }
                        } else {
                            return new Response(JSON.stringify({ error: '访问被拒绝', message: '路径验证失败' }), { status: 403, headers: { 'Content-Type': 'application/json' } });
                        }
                    }
                }

                // 处理 /test-api 接口
                if (url.pathname.endsWith('/test-api')) {
                    const 路径分段数组 = url.pathname.split('/').filter(p => p);
                    if (路径分段数组.length === 2 && 路径分段数组[1] === 'test-api') {
                        const 路径标识 = 路径分段数组[0];
                        let 验证通过 = false;
                        if (自定义路径 && 自定义路径.trim()) {
                            const 清洗 = 自定义路径.trim().startsWith('/') ? 自定义路径.trim().substring(1) : 自定义路径.trim();
                            验证通过 = (路径标识 === 清洗);
                        } else {
                            验证通过 = (校验UUID格式(路径标识) && 路径标识 === 用户UUID);
                        }
                        if (验证通过) {
                            try {
                                const 检测地区 = await 检测Worker地区(request);
                                return new Response(JSON.stringify({
                                    detectedRegion: 检测地区,
                                    message: 'API测试完成',
                                    timestamp: new Date().toISOString()
                                }), { headers: { 'Content-Type': 'application/json' } });
                            } catch (error) {
                                return new Response(JSON.stringify({
                                    error: error.message,
                                    message: 'API测试失败'
                                }), { status: 500, headers: { 'Content-Type': 'application/json' } });
                            }
                        } else {
                            return new Response(JSON.stringify({ error: '访问被拒绝', message: '路径验证失败' }), { status: 403, headers: { 'Content-Type': 'application/json' } });
                        }
                    }
                }

                // 首页
                if (url.pathname === '/') {
                    const 自定义首页 = 获取配置值('homepage', env.homepage || env.HOMEPAGE);
                    if (自定义首页 && 自定义首页.trim()) {
                        try {
                            const 首页响应 = await fetch(自定义首页.trim(), {
                                method: 'GET',
                                headers: {
                                    'User-Agent': request.headers.get('User-Agent') || 'Mozilla/5.0',
                                    'Accept': request.headers.get('Accept') || '*/*',
                                    'Accept-Language': request.headers.get('Accept-Language') || 'en-US,en;q=0.9',
                                },
                                redirect: 'follow'
                            });
                            if (首页响应.ok) {
                                const 内容类型 = 首页响应.headers.get('Content-Type') || 'text/html; charset=utf-8';
                                const 内容 = await 首页响应.text();
                                return new Response(内容, {
                                    status: 首页响应.status,
                                    headers: {
                                        'Content-Type': 内容类型,
                                        'Cache-Control': 'no-cache, no-store, must-revalidate',
                                    }
                                });
                            }
                        } catch (error) { console.error('获取自定义首页失败:', error); }
                    }
                    // 返回终端HTML（纯中文，无波斯语，无语言选择器）
                    const terminalHtml = `<!DOCTYPE html>
