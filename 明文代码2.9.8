    SOCKS5配置 = 获取配置值('s', '') || ''; if (SOCKS5配置) { try { 解析后的SOCKS5配置 = 解析SOCKS5配置(SOCKS5配置); 是否启用SOCKS5 = true; } catch (err) { 是否启用SOCKS5 = false; } } else 是否启用SOCKS5 = false;
    const yxby控制 = 获取配置值('yxby', ''); 禁用优选 = yxby控制 === 'yes';
