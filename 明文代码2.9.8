                if (confirm('确定要重置所有配置吗？这将清空所有KV配置，恢复为环境变量设置。')) {
                    try {
                        const response = await fetch(window.location.pathname + '/api/config', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ 
                                wk: '', d: '', p: '', yx: '', yxURL: '', s: '', ae: '', rm: '', qj: '',
                                yxby: '', ev: '', et: '', ex: '', tp: '', scu: '', epd: '', epi: '', egi: '',
                                ipv4: '', ipv6: '', ispMobile: '', ispUnicom: '', ispTelecom: '', homepage: '', alpn: ''
                            })
                        });
                        if (response.status === 503) {
                            显示状态消息('KV存储未配置，无法重置配置。', 'error');
                            return;
                        }
                        if (!response.ok) {
                            const errorText = await response.text();
