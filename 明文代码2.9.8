                        } finally {
                            获取IP按钮.disabled = false;
                            获取IP按钮.textContent = '⬇ 获取IP';
                        }
                    });
                }

                if (开始测试按钮) {
                    开始测试按钮.addEventListener('click', async function() {
                        const inputValue = 延迟测试输入框.value.trim();
                        const defaultPort = 延迟测试端口输入框.value || '443';
                        const threads = parseInt(测试线程输入框.value) || 5;
                        if (!inputValue) {
                            显示状态消息('请输入IP或域名', 'error');
                            return;
                        }
                        const targets = inputValue.split(',').map(t => t.trim()).filter(t => t);
                        if (targets.length === 0) return;

                        开始测试按钮.style.display = 'none';
                        停止测试按钮.style.display = 'inline-block';
                        测试状态元素.style.display = 'block';
                        测试结果容器.style.display = 'block';
                        结果列表元素.innerHTML = '';
                        测试结果数组 = [];
                        const 城市筛选容器 = document.getElementById('cityFilterContainer');
                        if (城市筛选容器) 城市筛选容器.style.display = 'none';

                        测试中止控制器 = new AbortController();
                        let completed = 0;
                        const total = targets.length;

                        function 解析目标(target) {
                            let host = target;
                            let port = defaultPort;
                            let nodeName = '';
                            if (target.includes('#')) {
                                const parts = target.split('#');
                                nodeName = parts[1] || '';
                                host = parts[0];
                            }
                            if (host.includes(':') && !host.startsWith('[')) {
                                const lastColon = host.lastIndexOf(':');
                                const possiblePort = host.substring(lastColon + 1);
                                if (/^[0-9]+$/.test(possiblePort)) {
                                    port = possiblePort;
                                    host = host.substring(0, lastColon);
                                }
                            } else if (host.includes(']:')) {
                                const parts = host.split(']:');
                                host = parts[0] + ']';
                                port = parts[1];
                            }
                            return { host, port, nodeName };
                        }

                        function 渲染结果(result, index) {
                            if (!result.success) return null;
                            const resultItem = document.createElement('div');
                            resultItem.style.cssText = 'display: flex; align-items: center; padding: 8px; border-bottom: 1px solid #003300; gap: 10px;';
                            resultItem.dataset.index = index;
                            resultItem.dataset.colo = result.colo || '';
                            const checkbox = document.createElement('input');
                            checkbox.type = 'checkbox';
                            checkbox.checked = true;
                            checkbox.disabled = false;
                            checkbox.dataset.index = index;
                            checkbox.style.cssText = 'width: 18px; height: 18px; cursor: pointer;';
                            const info = document.createElement('div');
                            info.style.cssText = 'flex: 1; font-family: monospace; font-size: 13px;';
                            const coloName = result.colo ? 获取数据中心名称(result.colo) : '';
                            const coloDisplay = coloName ? ' <span style="color: #00aaff;">[' + coloName + ']</span>' : '';
                            info.innerHTML = '<span style="color: #00f0ff;">' + result.host + ':' + result.port + '</span>' + coloDisplay + ' <span style="color: #ffff00;">' + result.latency + 'ms</span>';
                            resultItem.appendChild(checkbox);
                            resultItem.appendChild(info);
                            结果列表元素.appendChild(resultItem);
                            return resultItem;
                        }

                        async function 测试单个(target) {
                            if (测试中止控制器.signal.aborted) return null;
                            const { host, port, nodeName } = 解析目标(target);
                            const result = await 测试延迟(host, port, 测试中止控制器.signal);
                            result.host = host;
                            result.port = port;
                            result.nodeName = (result.success && result.colo) ? (nodeName || ('CF-' + result.colo)) : (nodeName || host);
                            return result;
                        }

                        for (let i = 0; i < total; i += threads) {
                            if (测试中止控制器.signal.aborted) break;
                            const batch = targets.slice(i, Math.min(i + threads, total));
                            测试状态元素.textContent = '测试中: ' + (i + 1) + '-' + Math.min(i + threads, total) + '/' + total + ' (线程: ' + threads + ')';
                            const results = await Promise.all(batch.map(t => 测试单个(t)));
                            for (const result of results) {
                                if (result) {
                                    const idx = 测试结果数组.length;
                                    测试结果数组.push(result);
                                    渲染结果(result, idx);
                                    completed++;
                                }
                            }
                        }
                        测试状态元素.textContent = '测试完成: ' + completed + '/' + total;
                        开始测试按钮.style.display = 'inline-block';
                        停止测试按钮.style.display = 'none';
                        更新城市筛选();
                    });
                }

                if (停止测试按钮) {
                    停止测试按钮.addEventListener('click', function() {
                        if (测试中止控制器) 测试中止控制器.abort();
                        开始测试按钮.style.display = 'inline-block';
                        停止测试按钮.style.display = 'none';
                        测试状态元素.textContent = '测试已停止';
                    });
                }

                if (全选按钮) {
                    全选按钮.addEventListener('click', function() {
                        const checkboxes = 结果列表元素.querySelectorAll('input[type="checkbox"]:not(:disabled)');
                        checkboxes.forEach(cb => cb.checked = true);
                    });
                }
                if (取消全选按钮) {
                    取消全选按钮.addEventListener('click', function() {
                        const checkboxes = 结果列表元素.querySelectorAll('input[type="checkbox"]');
                        checkboxes.forEach(cb => cb.checked = false);
                    });
                }

                function 获取选中的项目() {
                    const checkboxes = 结果列表元素.querySelectorAll('input[type="checkbox"]:checked');
                    if (checkboxes.length === 0) {
                        显示状态消息('请至少选择一项', 'error');
                        return null;
                    }
                    const selected = [];
                    checkboxes.forEach(cb => {
                        const idx = parseInt(cb.dataset.index);
                        const result = 测试结果数组[idx];
                        if (result && result.success) {
                            const coloName = result.colo ? 获取数据中心名称(result.colo) : result.nodeName;
                            selected.push(result.host + ':' + result.port + '#' + coloName);
                        }
                    });
                    return selected;
                }

                if (覆盖添加按钮) {
                    覆盖添加按钮.addEventListener('click', async function() {
                        const selected = 获取选中的项目();
                        if (!selected || selected.length === 0) return;
                        const yxInput = document.getElementById('yx');
                        yxInput.value = selected.join(',');
                        覆盖添加按钮.disabled = true;
                        追加添加按钮.disabled = true;
                        覆盖添加按钮.textContent = '保存中...';
                        try {
                            await 保存配置({ yx: yxInput.value });
                            显示状态消息('已覆盖 ' + selected.length + ' 项并已保存', 'success');
                        } catch (err) {
                            显示状态消息('保存失败: ' + err.message, 'error');
                        } finally {
                            覆盖添加按钮.disabled = false;
                            追加添加按钮.disabled = false;
                            覆盖添加按钮.textContent = '覆盖添加';
                        }
                    });
                }
                if (追加添加按钮) {
                    追加添加按钮.addEventListener('click', async function() {
                        const selected = 获取选中的项目();
                        if (!selected || selected.length === 0) return;
                        const yxInput = document.getElementById('yx');
                        const current = yxInput.value.trim();
                        const newValue = current ? (current + ',' + selected.join(',')) : selected.join(',');
                        yxInput.value = newValue;
                        覆盖添加按钮.disabled = true;
                        追加添加按钮.disabled = true;
                        追加添加按钮.textContent = '保存中...';
                        try {
                            await 保存配置({ yx: newValue });
                            显示状态消息('已追加 ' + selected.length + ' 项并已保存', 'success');
                        } catch (err) {
                            显示状态消息('保存失败: ' + err.message, 'error');
                        } finally {
                            覆盖添加按钮.disabled = false;
                            追加添加按钮.disabled = false;
                            追加添加按钮.textContent = '追加添加';
                        }
                    });
                }

                function IP转十六进制(ip) {
                    const parts = ip.split('.');
                    if (parts.length !== 4) return null;
                    let hex = '';
                    for (let i = 0; i < 4; i++) {
                        const num = parseInt(parts[i]);
                        if (isNaN(num) || num < 0 || num > 255) return null;
                        hex += num.toString(16).padStart(2, '0');
                    }
                    return hex;
                }

                const 数据中心映射 = {
                    'SJC': '🇺🇸 圣何塞', 'LAX': '🇺🇸 洛杉矶', 'SEA': '🇺🇸 西雅图', 'SFO': '🇺🇸 旧金山', 'DFW': '🇺🇸 达拉斯',
                    'ORD': '🇺🇸 芝加哥', 'IAD': '🇺🇸 华盛顿', 'ATL': '🇺🇸 亚特兰大', 'MIA': '🇺🇸 迈阿密', 'DEN': '🇺🇸 丹佛',
                    'PHX': '🇺🇸 凤凰城', 'BOS': '🇺🇸 波士顿', 'EWR': '🇺🇸 纽瓦克', 'JFK': '🇺🇸 纽约', 'LAS': '🇺🇸 拉斯维加斯',
                    'HKG': '🇭🇰 香港', 'NRT': '🇯🇵 东京成田', 'HND': '🇯🇵 东京羽田', 'KIX': '🇯🇵 大阪关西', 'ICN': '🇰🇷 首尔仁川',
                    'SIN': '🇸🇬 新加坡', 'LHR': '🇬🇧 伦敦', 'CDG': '🇫🇷 巴黎', 'FRA': '🇩🇪 法兰克福', 'AMS': '🇳🇱 阿姆斯特丹',
                };
                function 获取数据中心名称(colo) { return 数据中心映射[colo] || colo; }

                const 城市筛选容器 = document.getElementById('cityFilterContainer');
                const 城市复选框容器 = document.getElementById('cityCheckboxesContainer');

                function 更新城市筛选() {
                    if (!城市筛选容器 || !城市复选框容器) return;
                    const cityMap = new Map();
                    测试结果数组.forEach((result, idx) => {
                        if (result.success && result.colo) {
                            const colo = result.colo;
                            if (!cityMap.has(colo)) cityMap.set(colo, { colo, name: 获取数据中心名称(colo), count: 0 });
                            cityMap.get(colo).count++;
                        }
                    });
                    if (cityMap.size === 0) { 城市筛选容器.style.display = 'none'; return; }
                    城市筛选容器.style.display = 'block';
                    城市复选框容器.innerHTML = '';
                    const cities = Array.from(cityMap.values()).sort((a,b) => a.name.localeCompare(b.name));
                    cities.forEach(city => {
                        const label = document.createElement('label');
                        label.style.cssText = 'display: inline-flex; align-items: center; cursor: pointer; color: #00f0ff; font-size: 0.85rem; padding: 4px 8px; background: rgba(20,5,50,0.4); border:1px solid #7aa9c4; border-radius:4px;';
                        const cb = document.createElement('input');
                        cb.type = 'checkbox';
                        cb.value = city.colo;
                        cb.checked = true;
                        cb.dataset.colo = city.colo;
                        cb.style.cssText = 'margin-right:6px; width:16px; height:16px; cursor:pointer;';
                        const span = document.createElement('span');
                        span.textContent = city.name + ' (' + city.count + ')';
                        label.appendChild(cb);
                        label.appendChild(span);
                        城市复选框容器.appendChild(label);
                        cb.addEventListener('change', 按城市筛选结果);
                    });
                    const filterModeRadios = document.querySelectorAll('input[name="cityFilterMode"]');
                    filterModeRadios.forEach(radio => {
                        radio.addEventListener('change', function() {
                            if (this.value === 'all') {
                                const cbs = 城市复选框容器.querySelectorAll('input[type="checkbox"]');
                                cbs.forEach(cb => { cb.checked = true; cb.disabled = false; });
                            }
                            按城市筛选结果();
                        });
                    });
                }

                function 按城市筛选结果() {
                    if (!结果列表元素 || !城市复选框容器) return;
                    const filterMode = document.querySelector('input[name="cityFilterMode"]:checked')?.value || 'all';
                    const resultItems = 结果列表元素.querySelectorAll('[data-index]');
                    const cityCheckboxes = 城市复选框容器.querySelectorAll('input[type="checkbox"]');
                    if (filterMode === 'fastest10') {
                        const sorted = 测试结果数组.map((r,i)=> ({r,i})).filter(item=>item.r.success).sort((a,b)=>a.r.latency - b.r.latency).slice(0,10);
                        const fastestSet = new Set(sorted.map(item=>item.i));
                        resultItems.forEach(item => {
                            const idx = parseInt(item.dataset.index);
                            const cb = item.querySelector('input[type="checkbox"]');
                            if (fastestSet.has(idx)) { item.style.display = 'flex'; if (cb) cb.checked = true; }
                            else { item.style.display = 'none'; if (cb) cb.checked = false; }
                        });
                        cityCheckboxes.forEach(cb => cb.disabled = true);
                    } else {
                        const selectedCities = new Set();
                        cityCheckboxes.forEach(cb => { if (cb.checked) selectedCities.add(cb.value); });
                        const allChecked = cityCheckboxes.length > 0 && selectedCities.size === cityCheckboxes.length;
                        const noneChecked = selectedCities.size === 0;
                        resultItems.forEach(item => {
                            const colo = item.dataset.colo || '';
                            const cb = item.querySelector('input[type="checkbox"]');
                            if (allChecked || noneChecked || selectedCities.has(colo)) {
                                item.style.display = 'flex';
                                if (cb) {
                                    if (allChecked) cb.checked = true;
                                    else if (noneChecked) cb.checked = false;
                                    else cb.checked = selectedCities.has(colo);
                                }
                            } else {
                                item.style.display = 'none';
                                if (cb) cb.checked = false;
                            }
                        });
                        cityCheckboxes.forEach(cb => cb.disabled = false);
                    }
                }

                async function 测试延迟(host, port, signal) {
                    const timeout = 8000;
                    let colo = '';
                    let testUrl = '';
                    try {
                        const controller = new AbortController();
                        const timeoutId = setTimeout(() => controller.abort(), timeout);
                        if (signal) signal.addEventListener('abort', () => controller.abort());
                        const cleanHost = host.replace(/^\\[|\\]$/g, '');
                        const hexIP = IP转十六进制(cleanHost);
                        const testDomain = hexIP ? (hexIP + '.nip.lfree.org') : (cleanHost + '.nip.lfree.org');
                        testUrl = 'https://' + testDomain + ':' + port + '/';
                        console.log('[延迟测试] Testing:', testUrl, 'Original:', host + ':' + port);
                        const firstStart = Date.now();
                        const response1 = await fetch(testUrl, { signal: controller.signal });
                        const firstTime = Date.now() - firstStart;
                        if (!response1.ok) {
                            clearTimeout(timeoutId);
                            return { success: false, latency: firstTime, error: 'HTTP ' + response1.status, colo: '', testUrl };
                        }
                        try {
                            const text = await response1.text();
                            const data = JSON.parse(text);
                            if (data.colo) colo = data.colo;
                        } catch(e) {}
                        const secondStart = Date.now();
                        const response2 = await fetch(testUrl, { signal: controller.signal });
                        await response2.text();
                        const latency = Date.now() - secondStart;
                        clearTimeout(timeoutId);
                        return { success: true, latency, colo, testUrl };
                    } catch (error) {
                        const errorMsg = error.name === 'AbortError' ? '超时' : error.message;
                        return { success: false, latency: -1, error: errorMsg, colo: '', testUrl };
                    }
                }
            });
        </script>
    </body>
    </html>`;
    return new Response(pageHtml, { 
        status: 200, 
        headers: { 'Content-Type': 'text/html; charset=utf-8' } 
    });
}















// ==================== 配置API处理 ====================
async function 处理配置API(request) {
    if (request.method === 'GET') {
        if (!KV存储) {
            return new Response(JSON.stringify({ error: 'KV存储未配置', kvEnabled: false }), { status: 503, headers: { 'Content-Type': 'application/json' } });
        }
        // 强制刷新一次KV缓存，确保读取最新值
        await 加载KV配置(true);
        
        // 构建返回的配置对象，优先使用当前运行时的全局变量（即实际生效的值）
        const 实际配置 = {
            // 协议开关：使用全局运行时变量（这些变量已在 fetch 处理流程中根据 KV/env/默认值设置好）
            ev: 启用VLESS ? 'yes' : 'no',
            et: 启用Trojan ? 'yes' : 'no',
            ex: 启用XHTTP ? 'yes' : 'no',
            ech: 启用ECH ? 'yes' : 'no',
            ena: 启用原生地址 ? 'yes' : 'no',
            epd: 启用优选域名 ? 'yes' : 'no',
            epi: 启用优选IP ? 'yes' : 'no',
            egi: 启用GitHub优选 ? 'yes' : 'no',
            // 地区相关：优先使用手动指定地区（全局变量），否则从KV读取
            wk: 手动指定地区 || KV配置.wk || '',
            // 降级/地区匹配/优选控制
            qj: 启用降级模式 ? 'no' : '',
            rm: 启用地区匹配 ? '' : 'no',
            yxby: 禁用优选 ? 'yes' : '',
            // 其他配置项：KV存储值优先，否则使用全局变量（全局变量可能来自env）
            tp: Trojan密码 || KV配置.tp || '',
            scu: 订阅转换地址 !== 'https://url.v1.mk/sub' ? 订阅转换地址 : (KV配置.scu || ''),
            d: 自定义路径 || KV配置.d || '',
            p: 备用地址 || KV配置.p || '',
            yx: (自定义优选IP列表.length > 0 || 自定义优选域名列表.length > 0) ? (KV配置.yx || '') : (KV配置.yx || ''),
            yxURL: 优选IP来源URL || KV配置.yxURL || '',
            s: SOCKS5配置 || KV配置.s || '',
            homepage: KV配置.homepage || '',
            alpn: 自定义ALPN || KV配置.alpn || '',
            customDNS: 自定义DNS || KV配置.customDNS || '',
            customECHDomain: 自定义ECH域名 || KV配置.customECHDomain || '',
            // 优选IP筛选设置（默认均为 yes）
            ipv4: KV配置.ipv4 !== undefined ? KV配置.ipv4 : 'yes',
            ipv6: KV配置.ipv6 !== undefined ? KV配置.ipv6 : 'yes',
            ispMobile: KV配置.ispMobile !== undefined ? KV配置.ispMobile : 'yes',
            ispUnicom: KV配置.ispUnicom !== undefined ? KV配置.ispUnicom : 'yes',
            ispTelecom: KV配置.ispTelecom !== undefined ? KV配置.ispTelecom : 'yes',
            // API管理开关
            ae: KV配置.ae || '',
            // kvEnabled 标识
            kvEnabled: true
        };
        return new Response(JSON.stringify(实际配置), { headers: { 'Content-Type': 'application/json' } });
    } 
    else if (request.method === 'POST') {
        if (!KV存储) {
            return new Response(JSON.stringify({ success: false, message: 'KV存储未配置' }), { status: 503, headers: { 'Content-Type': 'application/json' } });
        }
        try {
            const 新配置 = await request.json();
            for (const [键, 值] of Object.entries(新配置)) {
                if (值 === '' || 值 === null || 值 === undefined) delete KV配置[键];
                else KV配置[键] = 值;
            }
            await 保存KV配置();
            更新配置变量();   // 同步更新全局运行时变量
            if (新配置.yx !== undefined) 从YX更新优选列表();
            return new Response(JSON.stringify({ success: true, message: '配置已保存', config: KV配置 }), { headers: { 'Content-Type': 'application/json' } });
        } catch (error) {
            return new Response(JSON.stringify({ success: false, message: '保存失败: ' + error.message }), { status: 500, headers: { 'Content-Type': 'application/json' } });
        }
    }
    return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers: { 'Content-Type': 'application/json' } });
}


async function 处理优选IPAPI(request) {
    if (!KV存储) return new Response(JSON.stringify({ success: false, error: 'KV存储未配置' }), { status: 503, headers: { 'Content-Type': 'application/json' } });
    const api启用 = 获取配置值('ae', '') === 'yes';
    if (!api启用) return new Response(JSON.stringify({ success: false, error: 'API功能未启用' }), { status: 403, headers: { 'Content-Type': 'application/json' } });
    try {
        if (request.method === 'GET') {
            const yx值 = 获取配置值('yx', '');
            const 解析结果 = 解析YX为数组(yx值);
            return new Response(JSON.stringify({ success: true, count: 解析结果.length, data: 解析结果 }), { headers: { 'Content-Type': 'application/json' } });
        } else if (request.method === 'POST') {
            const body = await request.json();
            const 要添加的IP = Array.isArray(body) ? body : [body];
            if (要添加的IP.length === 0) return new Response(JSON.stringify({ success: false, error: '请求数据为空' }), { status: 400, headers: { 'Content-Type': 'application/json' } });
            const yx值 = 获取配置值('yx', '');
            let 当前列表 = 解析YX为数组(yx值);
            const 已添加 = [];
            for (const 项 of 要添加的IP) {
                if (!项.ip) continue;
                const 端口 = 项.port || 443;
                const 名称 = 项.name || `API优选-${项.ip}:${端口}`;
                if (!校验IP地址(项.ip) && !校验域名(项.ip)) continue;
                const 存在 = 当前列表.some(ex => ex.ip === 项.ip && ex.port === 端口);
                if (!存在) { 当前列表.push({ ip: 项.ip, port: 端口, name: 名称, addedAt: new Date().toISOString() }); 已添加.push(项); }
            }
            if (已添加.length > 0) { const 新yx值 = 数组转YX(当前列表); await 设置配置值('yx', 新yx值); 从YX更新优选列表(); }
            return new Response(JSON.stringify({ success: true, message: `成功添加 ${已添加.length} 个IP`, added: 已添加.length }), { headers: { 'Content-Type': 'application/json' } });
        } else if (request.method === 'DELETE') {
            const body = await request.json();
            if (body.all === true) { await 设置配置值('yx', ''); 从YX更新优选列表(); return new Response(JSON.stringify({ success: true, message: '已清空所有优选IP' }), { headers: { 'Content-Type': 'application/json' } }); }
            if (!body.ip) return new Response(JSON.stringify({ success: false, error: 'IP地址是必需的' }), { status: 400, headers: { 'Content-Type': 'application/json' } });
            const 端口 = body.port || 443;
            const yx值 = 获取配置值('yx', '');
            let 当前列表 = 解析YX为数组(yx值);
            const 过滤后 = 当前列表.filter(item => !(item.ip === body.ip && item.port === 端口));
            if (过滤后.length === 当前列表.length) return new Response(JSON.stringify({ success: false, error: '优选IP不存在' }), { status: 404, headers: { 'Content-Type': 'application/json' } });
            const 新yx值 = 数组转YX(过滤后); await 设置配置值('yx', 新yx值); 从YX更新优选列表();
            return new Response(JSON.stringify({ success: true, message: '已删除' }), { headers: { 'Content-Type': 'application/json' } });
        } else return new Response(JSON.stringify({ error: '不支持的请求方法' }), { status: 405, headers: { 'Content-Type': 'application/json' } });
    } catch (error) {
        return new Response(JSON.stringify({ success: false, error: error.message }), { status: 500, headers: { 'Content-Type': 'application/json' } });
    }
}

