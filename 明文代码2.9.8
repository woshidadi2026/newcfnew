            async function 保存配置(configData) {
                const apiUrl = window.location.pathname + '/api/config';
                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(configData)
                    });
                    if (response.status === 503) {
                        显示状态消息('KV存储未配置，无法保存配置。请先在Cloudflare Workers中配置KV存储。', 'error');
                        return;
                    }
                    if (!response.ok) {
                        const errorText = await response.text();
                        try {
                            const errorData = JSON.parse(errorText);
                            显示状态消息(errorData.message || '保存失败', 'error');
                        } catch (parseError) {
                            显示状态消息('保存失败: ' + errorText, 'error');
                        }
                        return;
                    }
                    const result = await response.json();
                    显示状态消息(result.message, result.success ? 'success' : 'error');
                    if (result.success) {
                        await 加载当前配置();
                        更新wk地区状态();
                        setTimeout(function() { window.location.reload(); }, 1500);
                    }
                } catch (error) {
                    显示状态消息('保存失败: ' + error.message, 'error');
                }
            }

            function 显示状态消息(message, type) {
                const statusDiv = document.getElementById('statusMessage');
                if (statusDiv) {
                    statusDiv.textContent = message;
                    statusDiv.style.display = 'block';
                    statusDiv.style.color = type === 'success' ? '#00f0ff' : '#ff3860';
                    statusDiv.style.borderColor = type === 'success' ? '#00f0ff' : '#ff3860';
                    setTimeout(function() { statusDiv.style.display = 'none'; }, 3000);
                }
                if (typeof window.flashActionStatus === 'function') {
                    window.flashActionStatus(message, type === 'success' ? 'ok' : 'err');
                }
            }

