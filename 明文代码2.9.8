// 初始化KV存储
async function 初始化KV存储(env) {
    if (env.C) {
        try {
            KV存储 = env.C;
            await 加载KV配置();
        } catch (error) { KV存储 = null; }
    }
}

// 加载KV配置
async function 加载KV配置(强制刷新 = false) {
    if (!KV存储) return;
    if (!强制刷新 && KV配置最后加载时间 > 0 && (Date.now() - KV配置最后加载时间) < KV缓存TTL) return;
    try {
        let ver = '';
        try { ver = (await KV存储.get('c_ver')) || ''; } catch (_) {}
        if (!强制刷新 && ver && ver === kvConfigVersion && KV配置 && Object.keys(KV配置).length > 0) {
            KV配置最后加载时间 = Date.now();
            return;
        }
        const 配置数据 = await KV存储.get('c');
        if (配置数据) KV配置 = JSON.parse(配置数据);
        kvConfigVersion = ver;
        KV配置最后加载时间 = Date.now();
    } catch (error) { if (!KV配置) KV配置 = {}; }
}

// 保存KV配置
async function 保存KV配置() {
    if (!KV存储) return;
    try {
        const 配置字符串 = JSON.stringify(KV配置);
        await KV存储.put('c', 配置字符串);
        const 新版本号 = String(Date.now());
        kvConfigVersion = 新版本号;
        try { await KV存储.put('c_ver', 新版本号); } catch (_) {}
        KV配置最后加载时间 = Date.now();
    } catch (error) { throw error; }
}

// 获取配置值
function 获取配置值(键, 默认值 = '') {
    return KV配置[键] !== undefined ? KV配置[键] : 默认值;
}

// 设置配置值
async function 设置配置值(键, 值) {
    KV配置[键] = 值;
    await 保存KV配置();
}

