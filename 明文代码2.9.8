// 校验UUID格式
function 校验UUID格式(str) {
    const uuid正则 = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    return uuid正则.test(str);
}

// 校验IP地址
function 校验IP地址(ip) {
    const ipv4正则 = /^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/;
    if (ipv4正则.test(ip)) return true;
    const ipv6正则 = /^(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}$/;
    if (ipv6正则.test(ip)) return true;
    const ipv6短正则 = /^::1$|^::$|^(?:[0-9a-fA-F]{1,4}:)*::(?:[0-9a-fA-F]{1,4}:)*[0-9a-fA-F]{1,4}$/;
    return ipv6短正则.test(ip);
}

// 创建节点命名器（保留原逻辑）
function 创建节点命名器(跳过编号 = false) {
    const 强制跳过 = (typeof 优选IP来源URL !== 'undefined' && 优选IP来源URL && 优选IP来源URL.trim());
    let 跳过编号开关 = 强制跳过 || 跳过编号;
    const 计数器 = {};

    function 设置跳过编号(flag) { if (!强制跳过) 跳过编号开关 = flag; }
    function 命名器(基础名, 节点名 = null) {
        if (跳过编号开关 || (基础名 && 基础名.includes('.'))) return 节点名 || 基础名;
        if (!计数器[基础名]) 计数器[基础名] = 0;
        计数器[基础名]++;
        const 序号 = String(计数器[基础名]).padStart(2, '0');
        return `${节点名 || 基础名}-${序号}`;
    }
    return { 命名器, 设置跳过编号 };
}

function 规范化主机名(host) {
    return String(host || '').trim().replace(/^\[([^\]]+)\]$/, '$1');
}

function 压缩节点别名(value, fallback = 'Node') {
    let text = String(value || '').trim();
    if (!text || /^自定义优选-/i.test(text)) text = fallback;
    text = text
        .replace(/^\[([^\]]+)\]$/, '$1')
        .replace(/^https?:\/\//i, '')
        .replace(/[/?#].*$/, '')
        .replace(/\s+/g, '_');
    return text || fallback;
}

function 获取节点别名基(item) {
    const host = 规范化主机名(item?.ip || item?.domain || '');
    if (host && host.includes(':') && /^[0-9a-fA-F:.]+$/.test(host)) return 'IPv6优选';
    if (host && !校验IP地址(host)) return '优选域名';
    const isp = 压缩节点别名(item?.isp || item?.name || '', 'IPv4优选');
    const colo = 压缩节点别名(item?.colo || '', '');
    return colo ? `${isp}-${colo}` : isp;
}

function 创建紧凑节点命名器(跳过编号 = false) {
    const 计数器 = {};
    return (item) => {
        const base = 获取节点别名基(item);
        if (跳过编号) return base;
        计数器[base] = (计数器[base] || 0) + 1;
        return `${base}-${String(计数器[base]).padStart(2, '0')}`;
    };
}

function 规范化ALPN(value) {
    const 允许的值 = ['', 'h3', 'h2', 'http/1.1', 'h3,h2', 'h2,http/1.1', 'h3,h2,http/1.1'];
    const alpn = String(value || '').trim();
    return 允许的值.includes(alpn) ? alpn : '';
}

