// ==================== WebSocket 处理 ====================
async function 处理WebSocket请求(request) {
    const 请求URL = new URL(request.url);
    const 请求备用 = 请求URL.searchParams.get('p') || '';
    const 请求地区 = (请求URL.searchParams.get('wk') || '').toUpperCase();
    const 请求地区匹配字符串 = 请求URL.searchParams.get('rm') || '';
    const 请求地区匹配 = 请求地区匹配字符串 ? 请求地区匹配字符串.toLowerCase() !== 'no' : null;
    const 请求Socks字符串 = 请求URL.searchParams.get('s') || '';
    let 请求Socks配置 = null;
    if (请求Socks字符串) {
        try { 请求Socks配置 = 解析SOCKS5配置(请求Socks字符串); } catch (_) {}
    }

    let 生效地区 = 当前Worker地区;
    if (!生效地区 || 生效地区 === '') {
        if (请求地区) 生效地区 = 请求地区;
        else if (手动指定地区 && 手动指定地区.trim()) 生效地区 = 手动指定地区.trim().toUpperCase();
        else 生效地区 = await 检测Worker地区(request);
    } else if (请求地区) 生效地区 = 请求地区;

    const WS套接字对 = new WebSocketPair();
    const [客户端套接字, 服务端套接字] = Object.values(WS套接字对);
    服务端套接字.accept();
    服务端套接字.binaryType = 'arraybuffer';

    let 远端连接包装 = { socket: null, writer: null, drainUpload: null };
    let 是否DNS查询 = false;
    let 协议类型 = null;
    let 上行忙碌 = false;
    let 传输关闭 = false;
    const 上行队列 = 创建分块队列(上行合包大小, 上行队列最大字节, 上行队列最大字节 >> 8);
    const 请求获取器 = request.fetcher;

    function 释放远端写入器() {
        try { 远端连接包装.writer?.releaseLock(); } catch (_) {}
        远端连接包装.writer = null;
    }

    function 关闭传输() {
        if (传输关闭) return;
        传输关闭 = true;
        上行队列.clear();
        释放远端写入器();
        try { 远端连接包装.socket?.close(); } catch (_) {}
        关闭Socket静默(服务端套接字);
    }

    function 入队上行(块) {
        const data = 转Uint8Array(块);
        if (!data.byteLength) return true;
        if (!上行队列.sow(data)) {
            关闭传输();
            return false;
        }
        远端连接包装.drainUpload();
        return true;
    }

    async function 排空上行() {
        if (上行忙碌 || 传输关闭 || !远端连接包装.writer) return;
        上行忙碌 = true;
        try {
            for (;;) {
                if (传输关闭 || !远端连接包装.writer) break;
                const [data] = 上行队列.bundle();
                if (!data) break;
                await 远端连接包装.writer.write(data);
            }
        } catch (_) {
            关闭传输();
        } finally {
            上行忙碌 = false;
            if (!上行队列.empty && !传输关闭 && 远端连接包装.writer) queueMicrotask(排空上行);
        }
    }
    远端连接包装.drainUpload = () => {
        if (!上行忙碌 && !上行队列.empty && 远端连接包装.writer) queueMicrotask(排空上行);
    };

    const 早期数据 = request.headers.get(atob('c2VjLXdlYnNvY2tldC1wcm90b2NvbA==')) || '';
    const 可读流 = 创建WebSocket可读流(服务端套接字, 早期数据);

    可读流.pipeTo(new WritableStream({
        async write(块) {
            if (传输关闭) return;
            const data = 转Uint8Array(块);
            if (是否DNS查询) return await 转发UDP数据(data, 服务端套接字, null, 请求获取器);
            if (远端连接包装.socket && 远端连接包装.writer) {
                if (!入队上行(data)) throw new Error('上行队列溢出');
                return;
            }
            if (协议类型) {
                if (!入队上行(data)) throw new Error('上行队列溢出');
                return;
            }
            if (!协议类型) {
                if (启用VLESS && data.byteLength >= 24) {
                    const vless结果 = 解析WS首包(data, 用户UUID);
                    if (!vless结果.hasError) {
                        协议类型 = 'vless';
                        const { addressType, port, hostname, rawIndex, version, isUDP } = vless结果;
                        if (isUDP) {
                            if (port === 53) 是否DNS查询 = true;
                            else throw new Error(错误_UDP仅DNS);
                        }
                        const 响应头 = new Uint8Array([version[0], 0]);
                        const 原始数据 = data.subarray(rawIndex);
                        if (是否DNS查询) return 转发UDP数据(原始数据, 服务端套接字, 响应头, 请求获取器);
                        await 转发TCP连接(addressType, hostname, port, 原始数据, 服务端套接字, 响应头, 远端连接包装, 请求备用, 生效地区, 请求地区匹配, 请求Socks配置, 请求获取器);
                        return;
                    }
                }
                if (启用Trojan && data.byteLength >= 56) {
                    const trojan结果 = await 解析Trojan首包(data, 用户UUID);
                    if (!trojan结果.hasError) {
                        协议类型 = atob('dHJvamFu');
                        const { addressType, port, hostname, rawClientData } = trojan结果;
                        await 转发TCP连接(addressType, hostname, port, rawClientData, 服务端套接字, null, 远端连接包装, 请求备用, 生效地区, 请求地区匹配, 请求Socks配置, 请求获取器);
                        return;
                    }
                }
                throw new Error('Invalid protocol or authentication failed');
            }
        },
    })).catch(() => { 关闭传输(); });

    return new Response(null, { status: 101, webSocket: 客户端套接字 });
}

function 转Uint8Array(chunk) {
    if (chunk instanceof Uint8Array) return chunk;
    if (chunk instanceof ArrayBuffer) return new Uint8Array(chunk);
    if (ArrayBuffer.isView(chunk)) return new Uint8Array(chunk.buffer, chunk.byteOffset, chunk.byteLength);
    return new Uint8Array(chunk);
}

function 合并Uint8Array(head, body) {
    const h = 转Uint8Array(head);
    const b = 转Uint8Array(body);
    const out = new Uint8Array(h.byteLength + b.byteLength);
    out.set(h);
    out.set(b, h.byteLength);
    return out;
}

function 创建分块队列(cap, qCap = cap, itemsMax = Math.max(1, qCap >> 8)) {
    let queue = [];
    let head = 0;
    let queuedBytes = 0;
    let bundleBuffer = null;

    function trim() {
        if (head > 32 && head * 2 >= queue.length) {
            queue = queue.slice(head);
            head = 0;
        }
    }

    function take() {
        if (head >= queue.length) return null;
        const data = queue[head];
        queue[head++] = undefined;
        queuedBytes -= data.byteLength;
        trim();
        return data;
    }

    return {
        get empty() { return head >= queue.length; },
        clear() { queue = []; head = 0; queuedBytes = 0; },
        sow(data) {
            const n = data?.byteLength || 0;
            if (!n) return true;
            if (queuedBytes + n > qCap || queue.length - head >= itemsMax) return false;
            queue.push(data);
            queuedBytes += n;
            return true;
        },
        bundle(data = null) {
            data ||= take();
            if (!data || head >= queue.length || data.byteLength >= cap) return [data, false];
            let total = data.byteLength;
            let end = head;
            while (end < queue.length) {
                const next = queue[end];
                const nextTotal = total + next.byteLength;
                if (nextTotal > cap) break;
                total = nextTotal;
                end++;
            }
            if (end === head) return [data, false];
            const out = bundleBuffer ||= new Uint8Array(cap);
            out.set(data);
            let offset = data.byteLength;
            while (head < end) {
                const next = queue[head];
                queue[head++] = undefined;
                queuedBytes -= next.byteLength;
                out.set(next, offset);
                offset += next.byteLength;
            }
            trim();
            return [out.subarray(0, total), true];
        }
    };
}

function 创建下行合包发送器(webSocket) {
    const cap = 下行合包大小;
    const tail = 下行尾部阈值;
    const lowWater = Math.max(4096, tail << 3);
    let pending = new Uint8Array(cap);
    let pendingBytes = 0;
    let timer = 0;
    let microtaskQueued = false;
    let generation = 0;
    let quietKey = 0;
    let quietRounds = 0;

    function flush() {
        if (timer) clearTimeout(timer);
        timer = 0;
        microtaskQueued = false;
        if (!pendingBytes) return;
        if (webSocket.readyState === 1) webSocket.send(pending.subarray(0, pendingBytes).slice());
        pending = new Uint8Array(cap);
        pendingBytes = 0;
        quietRounds = 0;
    }

    function schedule() {
        if (timer || microtaskQueued) return;
        microtaskQueued = true;
        quietKey = generation;
        queueMicrotask(() => {
            microtaskQueued = false;
            if (!pendingBytes || timer) return;
            if (cap - pendingBytes < tail) return flush();
            timer = setTimeout(() => {
                timer = 0;
                if (!pendingBytes) return;
                if (cap - pendingBytes < tail) return flush();
                if (quietRounds < 2 && (generation !== quietKey || pendingBytes < lowWater)) {
                    quietRounds++;
                    quietKey = generation;
                    return schedule();
                }
                flush();
            }, Math.max(下行静默延迟, 1));
        });
    }

    return {
        send(chunk) {
            const data = 转Uint8Array(chunk);
            let offset = 0;
            const total = data.byteLength;
            if (!total) return;
            while (offset < total) {
                if (!pendingBytes && total - offset >= cap) {
                    const size = Math.min(cap, total - offset);
                    if (webSocket.readyState === 1) webSocket.send(offset || size !== total ? data.subarray(offset, offset + size) : data);
                    offset += size;
                    continue;
                }
                const size = Math.min(cap - pendingBytes, total - offset);
                pending.set(data.subarray(offset, offset + size), pendingBytes);
                pendingBytes += size;
                offset += size;
                generation++;
                if (pendingBytes === cap || cap - pendingBytes < tail) flush();
                else schedule();
            }
        },
        flush
    };
}

function 打开TCP套接字(address, port, requestFetcher = null) {
    const target = { hostname: address, port };
    if (requestFetcher && typeof requestFetcher.connect === 'function') return requestFetcher.connect(target);
    return connect(target);
}

async function 打开TCP套接字就绪(address, port, requestFetcher = null) {
    try {
        const socket = 打开TCP套接字(address, port, requestFetcher);
        if (socket?.opened) await socket.opened;
        return socket;
    } catch (error) {
        if (!requestFetcher) throw error;
        const socket = connect({ hostname: address, port });
        if (socket?.opened) await socket.opened;
        return socket;
    }
}

async function 连接TCP套接字(address, port, requestFetcher = null, raceCount = 1) {
    const count = Math.max(1, raceCount | 0);
    if (count <= 1) return 打开TCP套接字就绪(address, port, requestFetcher);
    const attempts = Array.from({ length: count }, () => 打开TCP套接字就绪(address, port, requestFetcher));
    const winner = await Promise.any(attempts);
    attempts.forEach((attempt) => {
        attempt.then((socket) => { if (socket !== winner) { try { socket.close(); } catch (_) {} } }, () => {});
    });
    return winner;
}

function 获取UUID字节(token) {
    if (UUID字节缓存.has(token)) return UUID字节缓存.get(token);
    const hex = String(token || '').replace(/-/g, '');
    if (hex.length !== 32) return null;
    const bytes = new Uint8Array(16);
    for (let i = 0; i < 16; i++) {
        const value = Number.parseInt(hex.slice(i * 2, i * 2 + 2), 16);
        if (Number.isNaN(value)) return null;
        bytes[i] = value;
    }
    if (UUID字节缓存.size > 16) UUID字节缓存.clear();
    UUID字节缓存.set(token, bytes);
    return bytes;
}

function 匹配UUID(bytes, offset, token) {
    const id = 获取UUID字节(token);
    return !!id &&
        bytes[offset] === id[0] && bytes[offset+1] === id[1] &&
        bytes[offset+2] === id[2] && bytes[offset+3] === id[3] &&
        bytes[offset+4] === id[4] && bytes[offset+5] === id[5] &&
        bytes[offset+6] === id[6] && bytes[offset+7] === id[7] &&
        bytes[offset+8] === id[8] && bytes[offset+9] === id[9] &&
        bytes[offset+10] === id[10] && bytes[offset+11] === id[11] &&
        bytes[offset+12] === id[12] && bytes[offset+13] === id[13] &&
        bytes[offset+14] === id[14] && bytes[offset+15] === id[15];
}

function 解析WS首包(块, token) {
    const bytes = 转Uint8Array(块);
    if (bytes.byteLength < 24) return { hasError: true, message: 错误_无效数据 };
    const version = bytes.subarray(0, 1);
    if (!匹配UUID(bytes, 1, token)) return { hasError: true, message: 错误_无效用户 };
    const optLen = bytes[17];
    const cmdIdx = 18 + optLen;
    if (bytes.byteLength < cmdIdx + 5) return { hasError: true, message: 错误_无效数据 };
    const cmd = bytes[cmdIdx];
    let isUDP = false;
    if (cmd === 1) {} else if (cmd === 2) { isUDP = true; } else { return { hasError: true, message: 错误_不支持命令 }; }
    const portIdx = 19 + optLen;
    const port = (bytes[portIdx] << 8) | bytes[portIdx + 1];
    let addrIdx = portIdx + 2, addrLen = 0, addrValIdx = addrIdx + 1, hostname = '';
    const addressType = bytes[addrIdx];
    switch (addressType) {
        case 地址类型_IPV4:
            addrLen = 4;
            if (bytes.byteLength < addrValIdx + addrLen) return { hasError: true, message: 错误_无效数据 };
            hostname = `${bytes[addrValIdx]}.${bytes[addrValIdx+1]}.${bytes[addrValIdx+2]}.${bytes[addrValIdx+3]}`;
            break;
        case 地址类型_URL:
            if (bytes.byteLength < addrValIdx + 1) return { hasError: true, message: 错误_无效数据 };
            addrLen = bytes[addrValIdx++];
            if (bytes.byteLength < addrValIdx + addrLen) return { hasError: true, message: 错误_无效数据 };
            hostname = 共享解码器.decode(bytes.subarray(addrValIdx, addrValIdx + addrLen));
            break;
        case 地址类型_IPV6:
            addrLen = 16;
            if (bytes.byteLength < addrValIdx + addrLen) return { hasError: true, message: 错误_无效数据 };
            const ipv6 = [];
            const ipv6View = new DataView(bytes.buffer, bytes.byteOffset + addrValIdx, addrLen);
            for (let i = 0; i < 8; i++) ipv6.push(ipv6View.getUint16(i * 2).toString(16));
            hostname = ipv6.join(':');
            break;
        default: return { hasError: true, message: `${错误_无效地址类型}: ${addressType}` };
    }
    if (!hostname) return { hasError: true, message: `${错误_地址为空}: ${addressType}` };
    return { hasError: false, addressType, port, hostname, isUDP, rawIndex: addrValIdx + addrLen, version };
}

function 创建WebSocket可读流(socket, earlyDataHeader) {
    let 已取消 = false;
    return new ReadableStream({
        start(控制器) {
            socket.addEventListener('message', (事件) => { if (!已取消) 控制器.enqueue(转Uint8Array(事件.data)); });
            socket.addEventListener('close', () => { if (!已取消) { 关闭Socket静默(socket); 控制器.close(); } });
            socket.addEventListener('error', (err) => 控制器.error(err));
            const { earlyData, error } = base64转数组(earlyDataHeader);
            if (error) 控制器.error(error); else if (earlyData) 控制器.enqueue(转Uint8Array(earlyData));
        },
        cancel() { 已取消 = true; 关闭Socket静默(socket); }
    });
}

async function 转发TCP连接(addrType, host, 端口号, 原始数据, ws, 响应头, 远端连接包装, 请求备用 = '', 请求地区 = '', 请求地区匹配 = null, 请求Socks配置 = null, 请求获取器 = null) {
    const 生效备用 = 请求备用 || 备用地址;
    const 生效地区 = 请求地区 || 当前Worker地区;
    const 生效地区匹配 = 请求地区匹配 !== null ? 请求地区匹配 : 启用地区匹配;
    const 生效Socks配置 = 请求Socks配置 || 解析后的SOCKS5配置;
    const 生效Socks启用 = 请求Socks配置 ? true : 是否启用SOCKS5;
    const 初始数据 = 转Uint8Array(原始数据);

    async function 连接并发送(地址, 端口, 使用Socks = false) {
        const 远端套接字 = 使用Socks ?
            await 建立SOCKS5连接(addrType, 地址, 端口, 生效Socks配置) :
            await 连接TCP套接字(地址, 端口, 请求获取器, 并发连接竞速数);
        const 写入器 = 远端套接字.writable.getWriter();
        if (初始数据.byteLength) await 写入器.write(初始数据);
        return { 远端套接字, 写入器 };
    }

    function 分离若当前(远端套接字, 写入器) {
        if (远端连接包装.socket !== 远端套接字) return;
        try { 写入器?.releaseLock(); } catch (_) {}
        远端连接包装.socket = null;
        远端连接包装.writer = null;
    }

    function 附加远端(远端套接字, 写入器, 重试函数) {
        try {
            if (远端连接包装.writer && 远端连接包装.writer !== 写入器) {
                远端连接包装.writer.releaseLock();
            }
        } catch (_) {}
        远端连接包装.socket = 远端套接字;
        远端连接包装.writer = 写入器;
        远端连接包装.drainUpload?.();
        远端套接字.closed.catch(() => {}).finally(() => {
            if (远端连接包装.socket === 远端套接字) 关闭Socket静默(ws);
        });
        连接流(远端套接字, ws, 响应头, 重试函数).finally(() => {
            if (远端连接包装.socket === 远端套接字) {
                try { 写入器.releaseLock(); } catch (_) {}
                远端连接包装.writer = null;
            }
        });
    }

    async function 重试连接() {
        if (启用降级模式 && 生效Socks启用) {
            try {
                const { 远端套接字: socks套接字, 写入器: socks写入器 } = await 连接并发送(host, 端口号, true);
                附加远端(socks套接字, socks写入器, null);
                return;
            } catch (socksErr) {
                let 备用主机, 备用端口;
                if (生效备用 && 生效备用.trim()) {
                    const 解析 = 解析地址和端口(生效备用);
                    备用主机 = 解析.地址;
                    备用端口 = 解析.端口 || 端口号;
                } else {
                    const 最佳备用IP = await 获取最佳备用IP(生效地区, 生效地区匹配);
                    备用主机 = 最佳备用IP ? 最佳备用IP.domain : host;
                    备用端口 = 最佳备用IP ? 最佳备用IP.port : 端口号;
                }
                try {
                    const { 远端套接字: 回退套接字, 写入器: 回退写入器 } = await 连接并发送(备用主机, 备用端口, false);
                    附加远端(回退套接字, 回退写入器, null);
                } catch (fallbackErr) { 关闭Socket静默(ws); }
            }
        } else {
            let 备用主机, 备用端口;
            if (生效备用 && 生效备用.trim()) {
                const 解析 = 解析地址和端口(生效备用);
                备用主机 = 解析.地址;
                备用端口 = 解析.端口 || 端口号;
            } else {
                const 最佳备用IP = await 获取最佳备用IP(生效地区, 生效地区匹配);
                备用主机 = 最佳备用IP ? 最佳备用IP.domain : host;
                备用端口 = 最佳备用IP ? 最佳备用IP.port : 端口号;
            }
            try {
                const { 远端套接字: 回退套接字, 写入器: 回退写入器 } = await 连接并发送(备用主机, 备用端口, 生效Socks启用);
                附加远端(回退套接字, 回退写入器, null);
            } catch (fallbackErr) { 关闭Socket静默(ws); }
        }
    }

    try {
        const { 远端套接字: 初始套接字, 写入器: 初始写入器 } = await 连接并发送(host, 端口号, 启用降级模式 ? false : 生效Socks启用);
        附加远端(初始套接字, 初始写入器, () => {
            分离若当前(初始套接字, 初始写入器);
            重试连接();
        });
    } catch (err) { await 重试连接(); }
}

async function 连接流(远端套接字, webSocket, 头数据, 重试函数) {
    let 头 = 头数据, 有数据 = false, 已重试 = false;
    let 首字节定时器 = null;
    if (重试函数) {
        首字节定时器 = setTimeout(() => {
            if (!有数据 && !已重试) {
                已重试 = true;
                try { 远端套接字.close && 远端套接字.close(); } catch (_) {}
                重试函数();
            }
        }, 首字节超时);
    }
    const tx = 创建下行合包发送器(webSocket);
    let reader = null;
    let byob = true;
    let buffer = new ArrayBuffer(传输块大小);
    try {
        try {
            reader = 远端套接字.readable.getReader({ mode: 'byob' });
        } catch (_) {
            byob = false;
            reader = 远端套接字.readable.getReader();
        }
        for (;;) {
            const result = byob ? await reader.read(new Uint8Array(buffer, 0, 传输块大小)) : await reader.read();
            if (result.done) break;
            const readValue = result.value;
            let chunk = 转Uint8Array(readValue);
            const reusableBuffer = byob && readValue?.buffer instanceof ArrayBuffer && readValue.buffer.byteLength >= 传输块大小
                ? readValue.buffer
                : new ArrayBuffer(传输块大小);
            if (!chunk.byteLength) continue;
            if (!有数据) {
                有数据 = true;
                if (首字节定时器) { clearTimeout(首字节定时器); 首字节定时器 = null; }
            }
            if (webSocket.readyState !== 1) throw new Error(错误_WS未打开);
            if (头) {
                chunk = 合并Uint8Array(头, chunk);
                头 = null;
            }
            if (chunk.byteLength >= (传输块大小 >> 1)) {
                tx.flush();
                webSocket.send(chunk);
                if (byob) buffer = new ArrayBuffer(传输块大小);
            } else {
                tx.send(chunk.slice());
                if (byob) buffer = reusableBuffer;
            }
        }
        tx.flush();
    } catch (error) {
        if (!已重试) 关闭Socket静默(webSocket);
    } finally {
        try { tx.flush(); } catch (_) {}
        try { reader?.releaseLock(); } catch (_) {}
    }
    if (首字节定时器) { clearTimeout(首字节定时器); 首字节定时器 = null; }
    if (!有数据 && !已重试 && 重试函数) 重试函数();
}

async function 转发UDP数据(udp块, webSocket, 响应头, 请求获取器 = null) {
    try {
        const tcp套接字 = await 连接TCP套接字('8.8.4.4', 53, 请求获取器, 1);
        let 头 = 响应头;
        const 写入器 = tcp套接字.writable.getWriter();
        await 写入器.write(udp块);
        写入器.releaseLock();
        await 连接流(tcp套接字, webSocket, 头, null);
    } catch (error) {}
}

async function 建立SOCKS5连接(addrType, address, port, socksConfig = 解析后的SOCKS5配置) {
    const { username, password, hostname, socksPort } = socksConfig;
    const socket = connect({ hostname, port: socksPort });
    const writer = socket.writable.getWriter();
    await writer.write(new Uint8Array(username ? [5, 2, 0, 2] : [5, 1, 0]));
    const reader = socket.readable.getReader();
    let res = (await reader.read()).value;
    if (res[0] !== 5 || res[1] === 255) throw new Error(错误_SOCKS无方法);
    if (res[1] === 2) {
        if (!username || !password) throw new Error(错误_SOCKS需要认证);
        const encoder = new TextEncoder();
        const authRequest = new Uint8Array([1, username.length, ...encoder.encode(username), password.length, ...encoder.encode(password)]);
        await writer.write(authRequest);
        res = (await reader.read()).value;
        if (res[0] !== 1 || res[1] !== 0) throw new Error(错误_SOCKS认证失败);
    }
    const encoder = new TextEncoder(); let DSTADDR;
    switch (addrType) {
        case 地址类型_IPV4: DSTADDR = new Uint8Array([1, ...address.split('.').map(Number)]); break;
        case 地址类型_URL: DSTADDR = new Uint8Array([3, address.length, ...encoder.encode(address)]); break;
        case 地址类型_IPV6: DSTADDR = new Uint8Array([4, ...address.split(':').flatMap(x => [parseInt(x.slice(0,2),16), parseInt(x.slice(2),16)])]); break;
        default: throw new Error(错误_无效地址类型);
    }
    await writer.write(new Uint8Array([5, 1, 0, ...DSTADDR, port >> 8, port & 255]));
    res = (await reader.read()).value;
    if (res[1] !== 0) throw new Error(错误_SOCKS连接失败);
    writer.releaseLock(); reader.releaseLock();
    return socket;
}

function 解析SOCKS5配置(地址) {
    let [后部, 前部] = 地址.split("@").reverse();
    let 用户名, 密码, 主机名, socks端口;
    if (前部) { const 分割 = 前部.split(":"); if (分割.length !== 2) throw new Error(错误_无效SOCKS地址); [用户名, 密码] = 分割; }
    const 后部分割 = 后部.split(":");
    socks端口 = Number(后部分割.pop());
    if (isNaN(socks端口)) throw new Error(错误_无效SOCKS地址);
    主机名 = 后部分割.join(":");
    if (主机名.includes(":") && !/^\[.*\]$/.test(主机名)) throw new Error(错误_无效SOCKS地址);
    return { username: 用户名, password: 密码, hostname: 主机名, port: socks端口 };
}

