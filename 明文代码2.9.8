async function 解析Wetest页面(url) {
    try {
        const 响应 = await fetch(url, { headers: { 'User-Agent': 'Mozilla/5.0' } });
        if (!响应.ok) return [];
        const html = await 响应.text();
        const 结果 = [];
        const 行正则 = /<tr[\s\S]*?<\/tr>/g;
        const 单元格正则 = /<td data-label="线路名称">(.+?)<\/td>[\s\S]*?<td data-label="优选地址">([\d.:a-fA-F]+)<\/td>[\s\S]*?<td data-label="数据中心">(.+?)<\/td>/;
        let 匹配;
        while ((匹配 = 行正则.exec(html)) !== null) {
            const 行html = 匹配[0];
            const 单元格匹配 = 行html.match(单元格正则);
            if (单元格匹配 && 单元格匹配[1] && 单元格匹配[2]) {
                const colo = 单元格匹配[3] ? 单元格匹配[3].trim().replace(/<.*?>/g, '') : '';
                结果.push({ isp: 单元格匹配[1].trim().replace(/<.*?>/g, ''), ip: 单元格匹配[2].trim(), colo: colo });
            }
        }
        return 结果;
    } catch (error) { return []; }
}

