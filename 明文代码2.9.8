// ==================== 订阅处理函数 ====================
async function 处理订阅请求(request, 用户, url = null) {
    if (!url) url = new URL(request.url);
    const 最终链接列表 = [];
    const worker域名 = url.hostname;
    const 目标类型 = url.searchParams.get('target') || 'base64';
    const 命名器 = 创建紧凑节点命名器(false);

    let ech配置 = null;
    if (启用ECH) {
        const dns服务器 = 自定义DNS || 'https://223.5.5.5/dns-query';
        const ech域名 = 自定义ECH域名 || 'cloudflare-ech.com';
        ech配置 = `${ech域名}+${dns服务器}`;
    }

    async function 从列表添加节点(列表) {
        if (启用VLESS) 最终链接列表.push(...从源生成VLESS链接(列表, 用户, worker域名, ech配置, false, 命名器));
        if (启用Trojan) 最终链接列表.push(...await 从源生成Trojan链接(列表, 用户, worker域名, ech配置, false, 命名器));
        if (启用XHTTP) 最终链接列表.push(...从源生成XHTTP链接(列表, 用户, worker域名, ech配置, false, 命名器));
    }

    if (启用原生地址) {
        if (当前Worker地区 === 'CUSTOM') {
            const 原生列表 = [{ ip: worker域名, isp: '原生地址' }];
            await 从列表添加节点(原生列表);
        } else {
            try {
                const 原生列表 = [{ ip: worker域名, isp: '原生地址' }];
                await 从列表添加节点(原生列表);
            } catch (error) {
                if (!当前Worker地区) 当前Worker地区 = await 检测Worker地区(request);
                const 最佳备用 = await 获取最佳备用IP(当前Worker地区);
                if (最佳备用) {
                    备用地址 = 最佳备用.domain + ':' + 最佳备用.port;
                    const 备用列表 = [{ ip: 最佳备用.domain, isp: 'ProxyIP-' + 当前Worker地区 }];
                    await 从列表添加节点(备用列表);
                } else {
                    const 原生列表 = [{ ip: worker域名, isp: '原生地址' }];
                    await 从列表添加节点(原生列表);
                }
            }
        }
    }

    const 有自定义优选 = 自定义优选IP列表.length > 0 || 自定义优选域名列表.length > 0;

    if (禁用优选) {
        // 什么都不做
    } else if (有自定义优选) {
        if (自定义优选IP列表.length > 0 && 启用优选IP) await 从列表添加节点(自定义优选IP列表);
        if (自定义优选域名列表.length > 0 && 启用优选域名) {
            const 域名列表 = 自定义优选域名列表.map(d => ({ ip: d.domain, isp: d.name || d.domain }));
            await 从列表添加节点(域名列表);
        }
    } else {
        if (启用优选域名) {
            const 域名列表 = 直连优选域名.map(d => ({ ip: d.domain, isp: d.name || d.domain }));
            await 从列表添加节点(域名列表);
        }
        if (启用优选IP) {
            if (!优选IP来源URL) {
                try {
                    const 动态IP列表 = await 获取动态优选IP();
                    if (动态IP列表.length > 0) await 从列表添加节点(动态IP列表);
                } catch (error) {
                    if (!当前Worker地区) 当前Worker地区 = await 检测Worker地区(request);
                    const 最佳备用 = await 获取最佳备用IP(当前Worker地区);
                    if (最佳备用) {
                        备用地址 = 最佳备用.domain + ':' + 最佳备用.port;
                        const 备用列表 = [{ ip: 最佳备用.domain, isp: 'ProxyIP-' + 当前Worker地区 }];
                        await 从列表添加节点(备用列表);
                    }
                }
            }
        }
        if (启用GitHub优选) {
            try {
                const 新IP列表 = await 获取并解析新IP();
                if (新IP列表.length > 0) {
                    if (启用VLESS) 最终链接列表.push(...从新IP生成VLESS链接(新IP列表, 用户, worker域名, ech配置, false, 命名器));
                    if (启用Trojan) 最终链接列表.push(...await 从新IP生成Trojan链接(新IP列表, 用户, worker域名, ech配置, false, 命名器));
                    if (启用XHTTP) 最终链接列表.push(...从源生成XHTTP链接(新IP列表, 用户, worker域名, ech配置, false, 命名器));
                }
            } catch (error) {
                if (!当前Worker地区) 当前Worker地区 = await 检测Worker地区(request);
                const 最佳备用 = await 获取最佳备用IP(当前Worker地区);
                if (最佳备用) {
                    备用地址 = 最佳备用.domain + ':' + 最佳备用.port;
                    const 备用列表 = [{ ip: 最佳备用.domain, isp: 'ProxyIP-' + 当前Worker地区 }];
                    await 从列表添加节点(备用列表);
                }
            }
        }
    }

    if (最终链接列表.length === 0) {
        const 错误备注 = "所有节点获取失败";
        const 协议 = atob('dmxlc3M=');
        const 错误链接 = `${协议}://00000000-0000-0000-0000-000000000000@127.0.0.1:80?encryption=none&security=none&type=ws&host=error.com&path=%2F#${encodeURIComponent(错误备注)}`;
        最终链接列表.push(错误链接);
    }

    let 订阅内容;
    let 内容类型 = 'text/plain; charset=utf-8';
    const 小写目标 = 目标类型.toLowerCase();

    switch (小写目标) {
        case atob('Y2xhc2g='):     // clash
        case atob('Y2xhc2hy'):     // clashr
        case 'stash':
        case 'meta':
        case 'clashmeta':
            订阅内容 = 生成ClashYAML(最终链接列表);
            内容类型 = 'text/yaml; charset=utf-8';
            break;
        case atob('c3VyZ2U='):     // surge
        case atob('c3VyZ2Uy'):
        case atob('c3VyZ2Uz'):
        case atob('c3VyZ2U0'):
            订阅内容 = 生成SurgeINI(最终链接列表);
            内容类型 = 'text/plain; charset=utf-8';
            break;
        case atob('cXVhbnR1bXVsdA=='):  // quantumult
        case atob('cXVhbng='):          // quanx
        case 'quanx':
            订阅内容 = 生成QuanxConf(最终链接列表);
            内容类型 = 'text/plain; charset=utf-8';
            break;
        case atob('c3M='):
        case atob('c3Ny'):
            订阅内容 = btoa(最终链接列表.join('\n'));
            break;
        case atob('djJyYXk='):
            订阅内容 = btoa(最终链接列表.join('\n'));
            break;
        case atob('bG9vbg=='):
            订阅内容 = 生成LoonINI(最终链接列表);
            内容类型 = 'text/plain; charset=utf-8';
            break;
        case atob('c2luZ2JveA=='):  // singbox
        case 'sing-box':
        case 'singbox':
            订阅内容 = 生成SingBoxJSON(最终链接列表);
            内容类型 = 'application/json; charset=utf-8';
            break;
        default:
            订阅内容 = btoa(最终链接列表.join('\n'));
    }

    const 响应头 = { 
        'Content-Type': 内容类型,
        'Cache-Control': 'no-store, no-cache, must-revalidate, max-age=0',
    };
    if (启用ECH) {
        响应头['X-ECH-Status'] = 'ENABLED';
        if (ech配置) 响应头['X-ECH-Config-Length'] = String(ech配置.length);
    }
    return new Response(订阅内容, { headers: 响应头 });
}

// ==================== 内部订阅转换器（不依赖外部 API）====================
function YAML引用(v) {
    if (v == null) return '""';
    const s = String(v);
    return '"' + s.replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"';
}

function 规范化服务器主机(hostname) {
    if (!hostname) return hostname;
    const h = String(hostname);
    if (h.startsWith('[') && h.endsWith(']')) return h.slice(1, -1);
    return h;
}

function Clash策略组代理列表(names, opts = {}) {
    const { 直连优先 = false, 额外组 = [] } = opts;
    const 节点行 = names.length ? names.map(n => `      - ${YAML引用(n)}`).join('\n') : '      - DIRECT';
    const lines = [];
    if (直连优先) {
        lines.push('      - "🎯 全球直连"', '      - "🚀 节点选择"');
    } else {
        lines.push('      - "🚀 节点选择"', '      - "🎯 全球直连"');
    }
    for (const g of 额外组) lines.push(`      - ${YAML引用(g)}`);
    lines.push(节点行);
    return lines.join('\n');
}

function INI策略组列表(names, opts = {}) {
    const { 直连优先 = false, 额外组 = [], 紧凑 = false } = opts;
    const sep = 紧凑 ? ',' : ', ';
    const list = names.length ? names.join(sep) : 'DIRECT';
    const parts = [];
    if (直连优先) parts.push('🎯 全球直连', '🚀 节点选择');
    else parts.push('🚀 节点选择', '🎯 全球直连');
    parts.push(...额外组);
    if (names.length) parts.push(list);
    return parts.join(sep);
}

// 解析分享链接为通用节点对象
function 解析分享链接(link) {
    try {
        if (link.startsWith('vless://')) {
            const url = new URL(link);
            const p = new URLSearchParams(url.search);
            return {
                proto: 'vless',
                name: decodeURIComponent(url.hash.substring(1)) || (url.hostname + ':' + url.port),
                uuid: url.username,
                server: 规范化服务器主机(url.hostname),
                port: parseInt(url.port) || 443,
                tls: p.get('security') === 'tls' || p.get('security') === 'reality',
                network: p.get('type') || 'ws',
                path: p.get('path') || '/?ed=2048',
                host: 规范化服务器主机(p.get('host') || url.hostname),
                sni: 规范化服务器主机(p.get('sni') || p.get('host') || url.hostname),
                alpn: (p.get('alpn') || '').split(',').map(s => s.trim()).filter(Boolean),
                fp: p.get('fp') || 'chrome',
                flow: p.get('flow') || '',
                encryption: p.get('encryption') || 'none',
                mode: p.get('mode') || '',
                ech: p.get('ech') || ''
            };
        }
        if (link.startsWith('trojan://')) {
            const url = new URL(link);
            const p = new URLSearchParams(url.search);
            return {
                proto: 'trojan',
                name: decodeURIComponent(url.hash.substring(1)) || (url.hostname + ':' + url.port),
                password: decodeURIComponent(url.username),
                server: 规范化服务器主机(url.hostname),
                port: parseInt(url.port) || 443,
                tls: true,
                network: p.get('type') || 'ws',
                path: p.get('path') || '/?ed=2048',
                host: 规范化服务器主机(p.get('host') || url.hostname),
                sni: 规范化服务器主机(p.get('sni') || p.get('host') || url.hostname),
                alpn: (p.get('alpn') || '').split(',').map(s => s.trim()).filter(Boolean),
                fp: p.get('fp') || 'chrome',
                ech: p.get('ech') || ''
            };
        }
    } catch (e) {}
    return null;
}

// 构建 Clash 节点块
function 构建Clash节点行(n) {
    const lines = [];
    const server = 规范化服务器主机(n.server);
    const host = 规范化服务器主机(n.host) || server;
    const sni = 规范化服务器主机(n.sni) || host;
    lines.push(`  - name: ${YAML引用(n.name)}`);
    lines.push(`    type: ${n.proto}`);
    lines.push(`    server: ${YAML引用(server)}`);
    lines.push(`    port: ${n.port}`);
    if (n.proto === 'vless') {
        lines.push(`    uuid: ${n.uuid}`);
        lines.push(`    udp: true`);
        lines.push(`    tls: ${n.tls ? 'true' : 'false'}`);
        if (n.flow) lines.push(`    flow: ${YAML引用(n.flow)}`);
        lines.push(`    client-fingerprint: ${YAML引用(n.fp || 'chrome')}`);
    } else if (n.proto === 'trojan') {
        lines.push(`    password: ${YAML引用(n.password)}`);
        lines.push(`    udp: true`);
        lines.push(`    client-fingerprint: ${YAML引用(n.fp || 'chrome')}`);
    }
    if (n.tls) {
        lines.push(`    servername: ${YAML引用(sni)}`);
        if (n.alpn && n.alpn.length) {
            lines.push(`    alpn: [${n.alpn.map(a => YAML引用(a)).join(', ')}]`);
        }
        lines.push(`    skip-cert-verify: false`);
    }
    if (n.network === 'ws' || n.network === 'xhttp') {
        lines.push(`    network: ws`);
        lines.push(`    ws-opts:`);
        lines.push(`      path: ${YAML引用(n.path)}`);
        lines.push(`      headers:`);
        lines.push(`        Host: ${YAML引用(host)}`);
    } else if (n.network === 'grpc') {
        lines.push(`    network: grpc`);
        lines.push(`    grpc-opts:`);
        lines.push(`      grpc-service-name: ${YAML引用(n.path)}`);
    }
    if (n.ech) {
        const echDomain = 自定义ECH域名 || 'cloudflare-ech.com';
        lines.push(`    ech-opts:`);
        lines.push(`      enable: true`);
        lines.push(`      query-server-name: ${YAML引用(echDomain)}`);
    }
    return lines.join('\n');
}

