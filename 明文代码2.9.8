    const 自定义DNS值 = 获取配置值('customDNS', ''); if (自定义DNS值 && 自定义DNS值.trim()) 自定义DNS = 自定义DNS值.trim();
    const 自定义ECH域名值 = 获取配置值('customECHDomain', ''); if (自定义ECH域名值 && 自定义ECH域名值.trim()) 自定义ECH域名 = 自定义ECH域名值.trim();
    自定义ALPN = 规范化ALPN(获取配置值('alpn', 'h3'));
